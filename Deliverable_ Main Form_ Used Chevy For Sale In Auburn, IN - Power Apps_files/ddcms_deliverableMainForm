// ─── Pre-Stage Change Gate ───────────────────────────────────────────────────

function processPreStageChange(executionContext) {
    console.log("Evaluating Pre Stage Change");

    // Evaluate admin override eligibility
    const allowedAdminRoleIds = [
        "ac551c72-dbe7-ef11-be21-000d3a8f4215", // operations
        "ef3df4b6-60b7-ef11-b8e9-000d3a5986ef"  // leadership
    ];
    const allowedAdminNav = Xrm.Utility.getGlobalContext().userSettings.roles
        .getAll()
        .some(role => allowedAdminRoleIds.includes(cleanGuid(role.id)));

    const preEventArgs      = executionContext.getEventArgs();
    const formContext       = executionContext.getFormContext();
    const movementDirection = preEventArgs._direction;
    const preProcessStageId = preEventArgs._stage._activeStageId;
    const expectedStageId   = preEventArgs._stage._stageStep.id;
    const recordId          = cleanGuid(formContext.data.entity.getId());

    const preStageParams = stages.find(s => s.stageId === preProcessStageId);

    // FIX: Guard against unknown stage
    if (!preStageParams) {
        console.error(`processPreStageChange: unrecognised stage id ${preProcessStageId}`);
        preEventArgs.preventDefault();
        return;
    }

    let processStageChange;

    if (movementDirection === 0) { // Forward
        if (preStageParams.canMoveFwd.includes(userId))  processStageChange = "proceed";
        else if (allowedAdminNav)                        processStageChange = "adminOverride";
        else                                             processStageChange = "unauthorized";
    } else { // Backward
        if (preStageParams.canMoveback.includes(userId)) processStageChange = "proceed";
        else if (allowedAdminNav)                        processStageChange = "adminOverride";
        else                                             processStageChange = "unauthorized";
    }

    const unauthorizedStrings = {
        text:               "You are not authorized to navigate the Business Process Flow Stage. If you need it moved, please see either the stage owner or your leader for assistance.",
        title:              "Unauthorized Process Navigation",
        confirmButtonLabel: "Understood"
    };

    switch (processStageChange) {
        case "proceed": // Authorised — proceed
            formContext.data.process.removeOnPreStageChange(processPreStageChange);
            if (movementDirection === 0) {
                executeStageChange(executionContext);
            } else {
                formContext.data.process.movePrevious();
            }
            break;

        case "adminOverride": // Admin override — confirm first
            preEventArgs.preventDefault();
            Xrm.Navigation.openConfirmDialog({
                text:               "You are moving this process to a stage not currently assigned to you. This may interrupt critical steps such as client approval, posting, or compliance. Are you sure?",
                title:              "Unauthorized Process Navigation",
                confirmButtonLabel: "Proceed",
                cancelButtonLabel:  "Cancel"
            }).then(function (response) {
                if (!response.confirmed) return;
                formContext.data.process.removeOnPreStageChange(processPreStageChange);
                if (movementDirection === 0) {
                    formContext.data.process.addOnPreStageChange(executeStageChange);
                    formContext.data.process.moveNext();
                } else {
                    formContext.data.process.movePrevious();
                }
            });
            break;

        case "unauthorized":   // Fully unauthorised
        default:
            preEventArgs.preventDefault();
            Xrm.Navigation.openAlertDialog(unauthorizedStrings);
            break;
    }
}

// ─── Process Status Change ───────────────────────────────────────────────────

function executeProcessStatusChange(executionContext) {
    const formContext  = executionContext.getFormContext();
    const recordId     = cleanGuid(formContext.data.entity.getId());
    const newStatus    = executionContext.getEventArgs()._status;

    let processDeliverableUpdate = {};
    let bannerMessage;

    switch (newStatus) {
        case 1: { // Active (reactivation)
            const currentStage   = formContext.data.process.getActiveStage().getId();
            const activatedStage = stages.find(s => s.stageId === currentStage);
            if (!activatedStage) { console.error("Reactivation: unknown stage id", currentStage); return; }

            processDeliverableUpdate.statecode  = 0;
            processDeliverableUpdate.statuscode = activatedStage.stageStatusCode;
            bannerMessage = "Deliverable & Tracking Process have been reactivated!";
            break;
        }
        case 2: // Finished
            processDeliverableUpdate.statecode            = 1;
            processDeliverableUpdate.statuscode           = 2;
            processDeliverableUpdate.ddcms_completeddate  = new Date();
            bannerMessage = "This Deliverable's process has been finished and marked complete!";
            break;

        case 3: // Aborted
            processDeliverableUpdate.statecode  = 1;
            processDeliverableUpdate.statuscode = 120730004;
            bannerMessage = "This Deliverable's process has been aborted and marked cancelled!";
            break;

        default:
            return;
    }

    Xrm.WebApi.updateRecord("ddcms_campaigndeliverable", recordId, processDeliverableUpdate)
        .then(function () {
            Xrm.App.addGlobalNotification({
                level: 1, message: bannerMessage, showCloseButton: true, type: 2
            }).then(function (notificationGuid) {
                sessionStorage.setItem("bannerGuid", notificationGuid);
                sessionStorage.setItem("clearBanner", "true");
                Xrm.Page.data.refresh();
                clearBanners(); // ensure clearBanners() is defined in a companion resource
            }).catch(err => console.error("Notification failed:", err.message));
        })
        .catch(err => console.error("Process status update failed:", err.message));
}

// ─── Form On Load ────────────────────────────────────────────────────────────

async function formCurrentState(executionContext) {
    console.log("Getting Form Current State");
    const formContext     = executionContext.getFormContext();
    formContext.ui.clearFormNotification("stage_lock");

    userId = cleanGuid(Xrm.Utility.getGlobalContext().userSettings.userId);

    const businessProcess = formContext.data.process;
    if (!businessProcess) {
        console.error("Business Process Flow not found on form.");
        return;
    }

    const activeStage = businessProcess.getActiveStage();
    let formLoadStageId = "70084cdd-4cb7-4992-b754-60926e709217"; // Default: Approval
    let activeStageName = "Approval";

    if (activeStage) {
        formLoadStageId = activeStage.getId();
        activeStageName = activeStage.getName();
    }

    // Cache frequently-used attribute values up front
    const selectedSubtype        = formContext.getAttribute("ddcms_deliverablesubtype").getValue();
    const postToSocial           = formContext.getAttribute("ddcms_posttosocialmedia").getValue();
    const selectedComplianceType = formContext.getAttribute("ddcms_compliancerequired").getValue() ?? null;
    const marketingPlan          = getLookupId(formContext, "ddcms_marketingplan");
    const parentCampaign         = getLookupId(formContext, "ddcms_campaign");

    // Fetch campaign & marketing plan data in parallel
    const [campaignRecord, marketingPlanRecord] = await Promise.all([
        parentCampaign ? getCampaignRecord(parentCampaign) : Promise.resolve(null),
        marketingPlan  ? getMarketingPlan(marketingPlan)   : Promise.resolve(null)
    ]);

    let includesSocial    = false;
    let campaignCoordinator, campaignSeo, campaignSocial, campaignOwnerId;

    if (campaignRecord) {
        const socialParamCheck = campaignRecord.ddcms_servicesutilized ?? null;
        includesSocial         = socialParamCheck ? socialParamCheck.includes(120730002) : false;
        campaignCoordinator    = campaignRecord._ddcms_cccontributor_value   ?? null;
        campaignSeo            = campaignRecord._ddcms_seocontributor_value  ?? null;
        campaignSocial         = campaignRecord._ddcms_socialcontributor_value ?? null;
        campaignOwnerId        = campaignRecord._ownerid_value               ?? null;
    } else {
        // No campaign — fall back to deliverable-level owner fields
        campaignCoordinator = getLookupId(formContext, "ddcms_ccowner");
        campaignSeo         = getLookupId(formContext, "ddcms_seoowner");
        campaignSocial      = getLookupId(formContext, "ddcms_socialowner");
    }

    const marketingPlanOwnerId = marketingPlanRecord?._ownerid_value ?? null;
    const campaignRecordOwnerId = campaignRecord?._ownerid_value ?? null;

    // Ensure the correct BPF is active
    const expectedBpfId   = "4B727CB5-404C-F011-8779-00224833DE88";
    const activeProcess   = businessProcess.getActiveProcess();
    if (!activeProcess || activeProcess.getId() !== expectedBpfId) {
        businessProcess.setActiveProcess(expectedBpfId, result => {
            if (result !== "success") console.error("Failed to activate BPF.");
        });
    }

    currentRoles = {
        marketingPlanOwner:  marketingPlanOwnerId,
        campaignOwner:       campaignOwnerId,
        seoOwner:            campaignSeo,
        socialOwner:         campaignSocial,
        pageBuildOwner:      getLookupId(formContext, "ddcms_pagebuildowner"),
        designOwner:         getLookupId(formContext, "ddcms_designowner"),
        designPostingOwner:  getLookupId(formContext, "ddcms_designpostingowner"),
        copywritingOwner:    getLookupId(formContext, "ddcms_copywritingowner"),
        complianceOwner:     getLookupId(formContext, "ddcms_complianceowner"),
        ccOwner:             campaignCoordinator,
        createdBy:           getLookupId(formContext, "createdby"),
        seoReportingOwner:   getLookupId(formContext, "ddcms_seoowner"),
