// ─── SLA Deadline ────────────────────────────────────────────────────────────

function unlockSlaDeadlineForDmm(formContext) {
    const slaDeadlineControl = formContext.getControl("header_ddcms_duedate");
    if (!slaDeadlineControl) return;

    const accountId = getLookupId(formContext, "ddcms_account");

    const allowedAdminRoleIds = [
        "ac551c72-dbe7-ef11-be21-000d3a8f4215", // operations
        "ef3df4b6-60b7-ef11-b8e9-000d3a5986ef"  // leadership
    ];
    const hasAdminRole = Xrm.Utility.getGlobalContext().userSettings.roles
        .getAll()
        .some(role => allowedAdminRoleIds.includes(cleanGuid(role.id)));

    // Admin/ops/leadership always gets unlocked regardless of account assignment
    if (hasAdminRole) {
        slaDeadlineControl.setDisabled(false);
        return;
    }

    if (!accountId) {
        console.warn("No account associated with this record.");
        slaDeadlineControl.setDisabled(true);
        return;
    }

    Xrm.WebApi.retrieveRecord("account", accountId, "?$select=_ddcms_managedservicescrm_value")
        .then(function (accountRecord) {
            const managedServicesCrmId = cleanGuid(accountRecord._ddcms_managedservicescrm_value);
            slaDeadlineControl.setDisabled(managedServicesCrmId !== userId);
        })
        .catch(function (error) {
            console.error("Error retrieving account record:", error.message);
            slaDeadlineControl.setDisabled(true);
        });
}

// ─── Environment Variables ───────────────────────────────────────────────────

async function getEnvironmentUrlParam(envSchemaNameColumn) {
    try {
        const result = await Xrm.WebApi.retrieveMultipleRecords(
            "environmentvariablevalue",
            `?$select=value&$expand=EnvironmentVariableDefinitionId` +
            `&$filter=EnvironmentVariableDefinitionId/schemaname eq '${envSchemaNameColumn}'`
        );

        if (!result.entities?.length) {
            console.warn(`No environment variable found for schema name: ${envSchemaNameColumn}`);
            return null;
        }

        return result.entities[0].value;
    } catch (error) {
        Xrm.Navigation.openErrorDialog({
            details: error.message,
            message: "A problem occurred while retrieving an Environment Variable value. Please contact support."
        });
        return null;
    }
}

// ─── Email Body Builder ──────────────────────────────────────────────────────

async function buildEmailBody(formContext, deliverableId, notifyingUser, appUrl, recordId, entityName, appId, deliverableName, emailSubject) {
    const deliverableType    = formContext.getAttribute("ddcms_deliverabletype").getText();
    const deliverableSubtype = formContext.getAttribute("ddcms_deliverablesubtype").getText();

    // FIX: accountsub was implicitly global and undefined when no account was set,
    // causing a ReferenceError in the subject line construction below.
    let accountRow = "";
    let accountsub = "";
    let campaignRow = "";
    let pageRow    = "";

    const accountId = getLookupId(formContext, "ddcms_account");
    if (accountId) {
        const accountRecord = await Xrm.WebApi.retrieveRecord(
            "account", accountId, "?$select=name,ddcms_productfulfillmentaccountid"
        );
        accountRow = `<li>Account Name: ${accountRecord.name}</li>` +
                     `<li>Account Id: ${accountRecord.ddcms_productfulfillmentaccountid}</li>`;
        accountsub = `${accountRecord.ddcms_productfulfillmentaccountid} | `;
    }

    const campaignId = getLookupId(formContext, "ddcms_campaign");
    if (campaignId) {
        const campaignRecord = await Xrm.WebApi.retrieveRecord(
            "ddcms_marketingcampaign", campaignId, "?$select=ddcms_campaignid,ddcms_name"
        );
        campaignRow = `<li>Campaign Name: ${campaignRecord.ddcms_name}</li>` +
                      `<li>Campaign Id: ${campaignRecord.ddcms_campaignid}</li>`;
    }

    const pageType = formContext.getAttribute("ddcms_pagetype").getText();
    if (pageType) pageRow = `<li>Page Type: ${pageType}</li>`;

    return {
        subject: `${accountsub}${deliverableId} | ${emailSubject}`,
        body:
            `Hello,
            <p>${notifyingUser} has moved ${deliverableId} into a stage that is ready for your input.</p>
            <ul>
                <li>Name: ${deliverableName}</li>
                ${accountRow}
                ${campaignRow}
                <li>Deliverable Type: ${deliverableType}</li>
                <li>Deliverable Subtype: ${deliverableSubtype}</li>
                ${pageRow}
            </ul>
            <h4><a href="${appUrl}/main.aspx?appid=${appId}&pagetype=entityrecord&etn=${entityName}&id=${recordId}">
                🧐 Review ${deliverableId}
            </a></h4>`
    };
}

