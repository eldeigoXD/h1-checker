// ─── HyperDrive Helpers ──────────────────────────────────────────────────────

const HYPERDRIVE_SOURCE_PATTERN = /<!-- source="(https:\/\/app\.prod\.seogen\.coxautoai\.com\/prompt\/[^"]+)" -->/;

function logHyperDriveUrl(executionContext) {
    const formContext = executionContext.getFormContext();
    const copyToEdit  = formContext.getAttribute("ddcms_copytoedit").getValue();
    // FIX: Guard against null before calling .match()
    if (!copyToEdit) return;

    const match = copyToEdit.match(HYPERDRIVE_SOURCE_PATTERN);
    if (!match) { console.log("Not eligible"); return; }

    const outSourceId = formContext.getAttribute("ddcms_copywritingoutsourceid");
    outSourceId.setValue(match[1]);
    formContext.getControl("ddcms_copytoedit").setDisabled(false);
    outSourceId.fireOnChange();
}

function updateCopyToEdit(executionContext) {
    const formContext  = executionContext.getFormContext();
    const copyAttribute = formContext.getAttribute("ddcms_copytoedit");
    const copyToEdit   = copyAttribute.getValue();
    // FIX: Guard against null before calling .includes()
    if (!copyToEdit) return;

    if (copyToEdit.match(HYPERDRIVE_SOURCE_PATTERN)) {
        // Strip the comment prefix — everything after '-->' is the real content
        const finalContent = copyToEdit.split("-->")[1]?.trim() ?? "";
        copyAttribute.setValue(finalContent);
    } else {
        console.log("Not eligible");
    }
}

