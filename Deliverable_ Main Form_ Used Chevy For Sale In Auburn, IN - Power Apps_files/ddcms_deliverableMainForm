// ─── HyperDrive Reset ────────────────────────────────────────────────────────

function resetHyperDriveStatus(executionContext) {
    const formContext        = executionContext.getFormContext();
    const outsourceStatus    = formContext.getAttribute("ddcms_iscopyoutsourced");

    if (outsourceStatus.getValue() !== false) return;

    Xrm.Navigation.openConfirmDialog({
        text:  "HyperDrive Generation Id and Copy to Edit will be deleted from this Record and you will have to start over.",
        title: "Are you sure you want to reset HyperDrive Generation Status"
    }).then(function (success) {
        if (success.confirmed) {
            formContext.getAttribute("ddcms_copytoedit").setValue(null);
            formContext.getAttribute("ddcms_copywritingoutsourceid").setValue(null);
        } else {
            outsourceStatus.setValue(true);
            formContext.getControl("ddcms_copytoedit").setVisible(true);
            formContext.getControl("ddcms_copywritingoutsourceid").setVisible(true);
        }
    });
}

// ─── Stage Change Execution ──────────────────────────────────────────────────

function executeStageChange(executionContext) {
    console.log("Executing Stage Change!");
    const formContext     = executionContext.getFormContext();
    // FIX: Remove the correct handler name. Previously this removed "executeStageChange"
    // which was never registered under that name — the registered handler is processPreStageChange.
    formContext.data.process.removeOnPreStageChange(processPreStageChange);

    const recordId         = cleanGuid(formContext.data.entity.getId());
    const changeEventArgs  = executionContext.getEventArgs();
    const entityName       = formContext.data.entity.getEntityName();
    const movementDirection = changeEventArgs._direction;
    const preProcessStageId = changeEventArgs._stage._activeStageId;
    const expectedStageId   = changeEventArgs._stage._stageStep.id;

    const currentStageParams  = stages.find(s => s.stageId === preProcessStageId);
    const expectedStageParams = stages.find(s => s.stageId === expectedStageId);

    // FIX: Guard against unrecognised stage ids to avoid cryptic TypeErrors downstream
    if (!currentStageParams || !expectedStageParams) {
        console.error(`Unknown stage id encountered: current=${preProcessStageId}, expected=${expectedStageId}`);
        return;
    }

    const deliverableUpdate = { statuscode: expectedStageParams.stageStatusCode };

    // FIX: Only write completedDate when the field name is actually defined for this stage.
    // Previously stages with completedDate:null would write deliverableUpdate["null"] = new Date().
    if (currentStageParams.completedDate) {
        deliverableUpdate[currentStageParams.completedDate] = new Date();
    }

    if (currentStageParams.lastReviewedBy) {
        deliverableUpdate[currentStageParams.lastReviewedBy] = `/systemusers(${userId})`;
    }

    Xrm.WebApi.updateRecord("ddcms_campaigndeliverable", recordId, deliverableUpdate)
        .then(function () {
            const pageInput = { pageType: "entitylist", entityName };
            const banner    = {
                level:           1,
                message:         currentStageParams.stageExitText,
                showCloseButton: true,
                type:            2
            };

            if (currentStageParams.notifyStakeholder === true) {
                buildEmailNotification(
                    formContext, currentStageParams.exitForm, pageInput,
                    recordId, entityName, currentStageParams.emailSubject,
                    currentStageParams.fieldToCheck, banner
                );
            } else {
                selfNotifyExitForm(banner, currentStageParams.exitForm, pageInput);
            }
        })
        .catch(function (error) {
            console.error("Failed to update record during stage change:", error.message);
            Xrm.Navigation.openErrorDialog({ message: "Stage update failed. Please try again or contact support.", details: error.message });
        });
}

// ─── Email Notification Builder ──────────────────────────────────────────────

async function buildEmailNotification(formContext, exitForm, pageInput, recordId, entityName, emailSubject, fieldToCheck, banner) {
    const notifyingUser   = Xrm.Utility.getGlobalContext().userSettings.userName;
    const deliverableId   = formContext.getAttribute("ddcms_deliverableid").getValue();
    const deliverableName = formContext.getAttribute("ddcms_name").getValue();

    const [flowUrlResult, appIdResult, appUrlResult, recipientResult] = await Promise.allSettled([
        getEnvironmentUrlParam("ddcms_EmailNotificationUrl"),
        getEnvironmentUrlParam("ddcms_ModelAppId"),
        getEnvironmentUrlParam("ddcms_ManagedServicesAppUrl"),
        defineNotificationRecipient(formContext, fieldToCheck)
    ]);

    const flowUrl  = flowUrlResult.status  === "fulfilled" ? flowUrlResult.value  : null;
    const appId    = appIdResult.status    === "fulfilled" ? appIdResult.value    : null;
    const appUrl   = appUrlResult.status   === "fulfilled" ? appUrlResult.value   : null;
    // FIX: recipient was previously an implicit global — now scoped correctly.
    const recipient = recipientResult.status === "fulfilled" ? recipientResult.value : null;

    // Guard: if we have no recipient we can still exit the form, just skip notifications.
    if (!recipient) {
        console.warn("No notification recipient resolved — skipping email and app notification.");
        selfNotifyExitForm(banner, exitForm, pageInput);
        return;
    }

    const emailBody = await buildEmailBody(
        formContext, deliverableId, notifyingUser,
        appUrl, recordId, entityName, appId, deliverableName, emailSubject
    );

    // In-app notification
    const sendAppNotificationStakeholder = new Example.SendAppNotificationRequest(
        `${deliverableId} Deliverable Activity Update`,
        `/systemusers(${cleanGuid(recipient.recipientId)})`,
        `${deliverableName} Updated by ${notifyingUser}`,
        200000000, 100000004, 200000000, 604800, null, null
    );

    Xrm.WebApi.online.execute(sendAppNotificationStakeholder)
        .then(r => r.ok ? r.json() : Promise.reject(r.statusText))
        .then(body => console.log("App notification sent:", body?.NotificationId))
        .catch(err => console.error("App notification failed:", err));

    // Email via Power Automate flow
    if (!flowUrl) {
        console.warn("Flow URL not available — skipping email notification.");
        selfNotifyExitForm(banner, exitForm, pageInput);
        return;
    }

    fetch(flowUrl, {
        method:  "POST",
        headers: { "Content-Type": "application/json" },
        body:    JSON.stringify({
            recipientDomains: recipient.recipientDomain,
            emailSubject:     emailBody.subject,
            emailBody:        emailBody.body,
            blindCarbonCopy:  "joe.evans@coxautoinc.com"
        })
    })
        .then(response => {
            if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
            return response.text().then(t => { try { return t ? JSON.parse(t) : {}; } catch { return {}; } });
        })
        .then(data  => console.log("Flow triggered successfully:", data))
        .catch(error => console.error("Error triggering flow:", error))
        .finally(() => selfNotifyExitForm(banner, exitForm, pageInput));
}

// ─── Self-Notify & Exit ──────────────────────────────────────────────────────

function selfNotifyExitForm(banner, exitForm, pageInput) {
    if (exitForm !== true) return;

    Xrm.App.addGlobalNotification(banner).then(function (notificationGuid) {
        // Persist banner guid so the list view can clear it on load
        const bannerGuids = JSON.parse(sessionStorage.getItem("bannerGuids") || "[]");
        bannerGuids.push(notificationGuid);
        sessionStorage.setItem("bannerGuids", JSON.stringify(bannerGuids));
        sessionStorage.setItem("clearBanner", "true");

        Xrm.Navigation.navigateTo(pageInput);
    }).catch(error => console.error("Failed to add global notification:", error.message));
}

