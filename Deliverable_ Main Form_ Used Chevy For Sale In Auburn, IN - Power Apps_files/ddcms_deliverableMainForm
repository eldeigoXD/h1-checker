// ddcms_ProofBanner.js
// Form script (JS web resource) for ddcms_campaigndeliverable Main Form.
// Owns show/hide of the WebResource_ProofBanner control so the form
// collapses its space correctly instead of leaving blank whitespace.
//
// Registration (Form Designer):
//   1. Add this as a JS web resource on the form's Form Libraries.
//   2. Form Properties > Events > On Load > Add function:
//        ddcms_ProofBanner.onFormLoad
//      Check "Pass execution context as first parameter".
//   No other designer event registration is needed - onFormLoad wires up
//   the field onChange and BPF stage-change listeners programmatically.

var ddcms_ProofBanner = ddcms_ProofBanner || {};

(function () {

  // Set to false once you've confirmed everything is working to quiet the console.
  ddcms_ProofBanner.DEBUG = true;

  ddcms_ProofBanner._log = function () {
    if (!ddcms_ProofBanner.DEBUG) return;
    var args = Array.prototype.slice.call(arguments);
    args.unshift("[ddcms_ProofBanner]");
    console.log.apply(console, args);
  };

  // Must match the exact control name given to the HTML web resource in
  // the Form Designer (select the control > Name field).
  ddcms_ProofBanner.WEBRESOURCE_CONTROL_NAME = "WebResource_Page_Proof_Required";

  ddcms_ProofBanner.FIELD_PILOT = "ddcms_pilottested";
  ddcms_ProofBanner.FIELD_SEO   = "cr65c_seoincluded";

  // Active BPF stage must be one of these for the banner to be eligible to show.
  ddcms_ProofBanner.VALID_STAGE_IDS = [
    "7b31af9b-5520-479d-92cf-9b46cc0bafb9", // page build without copy
    "56e1f7c8-6682-4193-9ae4-d8e690962c15"  // page build with copy
  ];

  ddcms_ProofBanner._normalizeGuid = function (id) {
    return id ? id.replace(/[{}]/g, "").toLowerCase() : "";
  };

  ddcms_ProofBanner._isActiveStageValid = function (formContext) {
    try {
      var process = formContext.data && formContext.data.process;
      if (!process) {
        ddcms_ProofBanner._log("BPF process object not found on formContext.data.");
        return false;
      }
      var stage = process.getActiveStage();
      if (!stage) {
        ddcms_ProofBanner._log("getActiveStage() returned null/undefined.");
        return false;
      }
      var rawId = stage.getId();
      var normalizedId = ddcms_ProofBanner._normalizeGuid(rawId);
      var isValid = ddcms_ProofBanner.VALID_STAGE_IDS.indexOf(normalizedId) !== -1;
      ddcms_ProofBanner._log(
        "Active stage name:", stage.getName ? stage.getName() : "(no getName)",
        "| raw id:", rawId,
        "| normalized id:", normalizedId,
        "| in allowed list:", isValid
      );
      return isValid;
    } catch (e) {
      ddcms_ProofBanner._log("Error while reading active stage:", e.message || e);
      return false;
    }
  };

  // Retries the control lookup on its own in case the control registers a
  // beat after OnLoad fires (e.g. behind a tab that hasn't rendered yet).
  // Gives up quietly after a bounded number of attempts.
  ddcms_ProofBanner._applyVisibility = function (formContext, shouldShow, attempt) {
    attempt = attempt || 1;
    var control = null;
    try {
      control = formContext.ui.controls.get(ddcms_ProofBanner.WEBRESOURCE_CONTROL_NAME);
    } catch (e) {
      ddcms_ProofBanner._log("Error calling ui.controls.get():", e.message || e);
    }

    ddcms_ProofBanner._log(
      "Attempt", attempt, "- control lookup for '" + ddcms_ProofBanner.WEBRESOURCE_CONTROL_NAME + "':",
      control ? "FOUND" : "NOT FOUND",
      "| target visibility:", shouldShow
    );

    if (control && control.setVisible) {
      control.setVisible(shouldShow);
      ddcms_ProofBanner._log(
        "setVisible(" + shouldShow + ") called. Control now reports getVisible():",
        control.getVisible ? control.getVisible() : "(no getVisible method)"
      );
      return;
    }

    if (attempt < 15) {
      setTimeout(function () {
        ddcms_ProofBanner._applyVisibility(formContext, shouldShow, attempt + 1);
      }, 500);
    } else {
      console.warn(
        "ddcms_ProofBanner: could not find control '" +
          ddcms_ProofBanner.WEBRESOURCE_CONTROL_NAME +
          "' after " + attempt + " attempts. Confirm the name matches the " +
          "control name set in the Form Designer."
      );
    }
  };

  ddcms_ProofBanner.toggleVisibility = function (executionContext) {
    ddcms_ProofBanner._log("toggleVisibility() fired.");
    var formContext = executionContext.getFormContext();

    var pilotAttr = formContext.getAttribute(ddcms_ProofBanner.FIELD_PILOT);
    var seoAttr   = formContext.getAttribute(ddcms_ProofBanner.FIELD_SEO);

    if (!pilotAttr) {
      ddcms_ProofBanner._log("WARNING: attribute '" + ddcms_ProofBanner.FIELD_PILOT + "' not found on form. Check the logical name / that it's on this form.");
    }
    if (!seoAttr) {
      ddcms_ProofBanner._log("WARNING: attribute '" + ddcms_ProofBanner.FIELD_SEO + "' not found on form. Check the logical name / that it's on this form.");
    }

    var pilotTested = pilotAttr ? pilotAttr.getValue() === true : false;
    var seoIncluded = seoAttr   ? seoAttr.getValue()   === true : false;

    ddcms_ProofBanner._log(
      ddcms_ProofBanner.FIELD_PILOT + ":", pilotAttr ? pilotAttr.getValue() : "(attribute missing)",
      "|", ddcms_ProofBanner.FIELD_SEO + ":", seoAttr ? seoAttr.getValue() : "(attribute missing)"
    );

    var stageValid = ddcms_ProofBanner._isActiveStageValid(formContext);

    var shouldShow =
      pilotTested === true &&
      seoIncluded === false &&
      stageValid;

    ddcms_ProofBanner._log(
      "Decision -> pilotTested:", pilotTested,
      "| seoIncluded:", seoIncluded,
      "| stageValid:", stageValid,
      "| FINAL shouldShow:", shouldShow
    );

    ddcms_ProofBanner._applyVisibility(formContext, shouldShow, 1);
  };

  ddcms_ProofBanner.onFormLoad = function (executionContext) {
    ddcms_ProofBanner._log("onFormLoad() fired.");
    var formContext = executionContext.getFormContext();

    // Re-evaluate whenever the relevant fields change.
    [ddcms_ProofBanner.FIELD_PILOT, ddcms_ProofBanner.FIELD_SEO].forEach(function (fieldName) {
      var attr = formContext.getAttribute(fieldName);
      if (attr) {
        attr.addOnChange(ddcms_ProofBanner.toggleVisibility);
        ddcms_ProofBanner._log("onChange listener registered for", fieldName);
      } else {
        ddcms_ProofBanner._log("WARNING: could not register onChange - attribute", fieldName, "not found.");
      }
    });

    // Re-evaluate whenever the BPF active stage changes.
    if (formContext.data && formContext.data.process) {
      if (formContext.data.process.addOnStageChange) {
        formContext.data.process.addOnStageChange(ddcms_ProofBanner.toggleVisibility);
        ddcms_ProofBanner._log("addOnStageChange listener registered.");
      }
      if (formContext.data.process.addOnStageSelected) {
        formContext.data.process.addOnStageSelected(ddcms_ProofBanner.toggleVisibility);
        ddcms_ProofBanner._log("addOnStageSelected listener registered.");
      }
    } else {
      ddcms_ProofBanner._log("WARNING: formContext.data.process not available at OnLoad - no BPF on this form/instance?");
    }

    // Initial evaluation on load.
    ddcms_ProofBanner.toggleVisibility(executionContext);
  };

})();