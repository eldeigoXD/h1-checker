        control.setVisible(!!props.visible);
        control.setDisabled(!!props.disabled);

        if (props.headerPresent === true) {
            const headerControl = formContext.getControl(`header_process_${field}`);
            headerControl?.setDisabled(!!props.disabled);
        }
    }

    if (formLocked) {
        formContext.ui.setFormNotification(
