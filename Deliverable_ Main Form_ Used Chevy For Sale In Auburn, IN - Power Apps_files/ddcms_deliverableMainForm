// ─── Module-level state ────────────────────────────────────────────────────
// RISK: These globals can hold stale data during rapid navigation between records.
// Kept as-is since the BPF pattern requires them, but formCurrentState always
// reinitialises them before use.
var currentRoles;
var stages;
var userId;
var formReloadEnabled = false;

// ─── Utility helpers ────────────────────────────────────────────────────────

/**
 * Strips Dataverse GUID braces/hyphens to a plain lowercase id string.
 * Centralised here to avoid repetitive inline .replace() chains.
 */
function cleanGuid(raw) {
    if (!raw) return null;
    return raw.toLowerCase().replace(/[{}]/g, "");
}

/**
 * Safe attribute getter — returns null instead of throwing when attribute
 * or its lookup value is absent.
 */
function getLookupId(formContext, attributeName) {
    return cleanGuid(
        formContext.getAttribute(attributeName)?.getValue()?.[0]?.id ?? null
    );
}

