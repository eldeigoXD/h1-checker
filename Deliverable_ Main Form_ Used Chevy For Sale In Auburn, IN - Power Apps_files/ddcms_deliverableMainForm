        formContext.ui.setFormNotification(
            `Editing as Leadership/Operations — you are not an assigned owner for stage: ${activeStageName}`,
            "INFO", "stage_lock"
        );
    }

    unlockSlaDeadlineForDmm(formContext);

    // FIX: addOnPreStageChange was called unconditionally on every formCurrentState invocation,
