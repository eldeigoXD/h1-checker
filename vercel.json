{
  "version": 2,
  "builds": [
    {
      "src": "vercel/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "vercel/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/vercel/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/vercel/public/$1"
    }
  ]
}
